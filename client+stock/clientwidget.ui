          <item>
           <widget class="QLabel" name="labelEmail">
            <property name="text">
             <string>Email</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="inputEmail"/>
          </item>
          <item>
           <widget class="QLabel" name="labelTelephone">
