<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ClientWidget</class>
 <widget class="QWidget" name="ClientWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>768</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Gestion Clients</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget#ClientWidget {
    background: #f5f5f5;
}

QTabWidget::pane {
    border: 2px solid #5d732c;
    border-radius: 8px;
    background: white;
    top: -2px;
}

QTabBar::tab {
    background: #f0f0f0;
    color: #2d4a1f;
    padding: 12px 30px;
    margin-right: 5px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 13px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #b39609;
    color: white;
}

QTabBar::tab:hover {
    background: #c9a80a;
}

/* Search Box */
QLineEdit#searchBox {
    padding: 10px 15px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    font-size: 13px;
    color: #2d4a1f;
}

/* Action Buttons */
QPushButton {
    background: #b39609;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton:hover {
    background: #c9a80a;
}

QPushButton#btnDeleteForm {
    background: #dc3545;
}

QPushButton#btnDeleteForm:hover {
    background: #c82333;
}

/* Table */
QTableWidget {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
    gridline-color: #e0e0e0;
    font-size: 13px;
    color: #2d4a1f;
}

QTableWidget::item:selected {
    background: #b39609;
    color: white;
}

QHeaderView::section {
    background: #5d732c;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
    font-size: 13px;
}

/* Form Panel */
QFrame#formPanel {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
}

QLabel {
    color: #2d4a1f;
    font-weight: bold;
}

QLineEdit, QComboBox, QTextEdit {
    padding: 8px 12px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    color: #2d4a1f;
    font-size: 13px;
}

QTextEdit {
    min-height: 80px;
    max-height: 100px;
}
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>10</number>
   </property>
   <property name="margin" stdset="0">
    <number>10</number>
   </property>
   <!-- Barre de recherche -->
   <item>
    <layout class="QHBoxLayout" name="searchLayout">
     <property name="spacing">
      <number>10</number>
     </property>
     <item>
      <widget class="QLineEdit" name="searchBox">
       <property name="placeholderText">
        <string>Rechercher un client...</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnSearch">
       <property name="text">
        <string>🔍</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnRefresh">
       <property name="text">
        <string>🔄</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnClear">
       <property name="text">
        <string>✖</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <!-- Onglet Liste des Clients -->
     <widget class="QWidget" name="tab1">
      <attribute name="title">
       <string>Liste des Clients</string>
      </attribute>
      <layout class="QHBoxLayout" name="tab1Layout">
       <property name="spacing">
        <number>15</number>
       </property>
       <property name="margin">
        <number>10</number>
       </property>
       <!-- Tableau -->
       <item>
        <widget class="QTableWidget" name="clientTable">
         <column>
          <property name="text">
           <string>ID</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Nom</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Prénom</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Email</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Téléphone</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Type Client</string>
          </property>
         </column>
        </widget>
       </item>
       <!-- Formulaire -->
       <item>
        <widget class="QFrame" name="formPanel">
         <property name="minimumSize">
          <size>
           <width>300</width>
           <height>0</height>
          </size>
         </property>
         <layout class="QVBoxLayout" name="formLayout">
          <property name="spacing">
           <number>10</number>
          </property>
          <property name="margin">
           <number>10</number>
          </property>
          <item>
           <widget class="QLabel" name="labelIdClient">
            <property name="text">
             <string>ID Client</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="inputIdClient">
            <property name="readOnly">
             <bool>true</bool>
            </property>
            <property name="placeholderText">
             <string>Généré automatiquement</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="labelNom">
            <property name="text">
             <string>Nom</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="inputNom"/>
          </item>
          <item>
           <widget class="QLabel" name="labelPrenom">
            <property name="text">
             <string>Prénom</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="inputPrenom"/>
