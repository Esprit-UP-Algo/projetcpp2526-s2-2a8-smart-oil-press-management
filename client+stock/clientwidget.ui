              <string>Revendeur</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Grossiste</string>
             </property>
            </item>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="labelFeedback">
            <property name="text">
             <string>Feedback / Avis</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QTextEdit" name="inputFeedback"/>
          </item>
          <item>
           <layout class="QHBoxLayout" name="formButtons">
            <item>
             <widget class="QPushButton" name="btnAdd">
              <property name="text">
               <string>Ajouter</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnUpdate">
              <property name="text">
               <string>Modifier</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnDeleteForm">
              <property name="text">
               <string>Supprimer</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Onglet Statistiques -->
     <widget class="QWidget" name="tab2">
      <attribute name="title">
       <string>Statistiques</string>
