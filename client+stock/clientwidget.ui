            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="inputTelephone"/>
          </item>
          <item>
           <widget class="QLabel" name="labelTypeClient">
            <property name="text">
             <string>Type Client</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="inputTypeClient">
            <item>
             <property name="text">
