    border: none;
}

/* Navigation Buttons */
QPushButton.navButton {
    background: #b39609;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
}

QPushButton.navButton:hover {
    background: #c9a80a;
}

QPushButton.settingsButton {
    background: transparent;
    color: #b39609;
    border: none;
    padding: 8px;
    font-size: 12px;
    text-align: left;
}

QPushButton.settingsButton:hover {
