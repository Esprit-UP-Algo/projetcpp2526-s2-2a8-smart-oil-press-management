}

/* Header */
QFrame#headerFrame {
    background: #ffffff;
    border: none;
    border-bottom: 3px solid #5d732c;
}

QLabel#headerTitle {
    color: #2d4a1f;
    font-size: 28px;
    font-weight: bold;
}
