<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>StockWidget</class>
 <widget class="QWidget" name="StockWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Gestion des Stocks</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget#StockWidget {
    background: #f5f5f5;
}

/* Search Box */
QLineEdit#searchBox {
    padding: 10px 15px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    font-size: 13px;
    color: #2d4a1f;
}

/* Buttons */
QPushButton {
    background: #b39609;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton:hover {
    background: #c9a80a;
}
QPushButton#btnDeleteForm {
    background: #dc3545;
}
QPushButton#btnDeleteForm:hover {
    background: #c82333;
}

/* Table */
QTableWidget {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
    gridline-color: #e0e0e0;
    font-size: 13px;
    color: #2d4a1f;
}
QTableWidget::item:selected {
    background: #b39609;
    color: white;
}
QHeaderView::section {
    background: #5d732c;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
    font-size: 13px;
}

/* Form Panel */
QFrame#formPanel {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
}
QLabel {
    color: #2d4a1f;
    font-weight: bold;
}
QLineEdit, QSpinBox, QComboBox {
    padding: 8px 12px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    color: #2d4a1f;
    font-size: 13px;
}
   </string>
  </property>

  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>15</number>
   </property>
   <property name="margin" stdset="0">
    <number>15</number>
   </property>
   <!-- Barre de recherche -->
   <item>
    <layout class="QHBoxLayout" name="searchLayout">
     <property name="spacing">
      <number>10</number>
     </property>
     <item>
      <widget class="QLineEdit" name="searchBox">
       <property name="placeholderText">
        <string>Rechercher un stock...</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnSearch">
       <property name="text">
        <string>🔍</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnRefresh">
       <property name="text">
        <string>🔄</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnClear">
       <property name="text">
        <string>✖</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Contenu principal : table + formulaire -->
   <item>
    <layout class="QHBoxLayout" name="contentLayout">
     <property name="spacing">
      <number>20</number>
     </property>
     <item>
      <widget class="QTableWidget" name="stockTable">
       <column>
        <property name="text">
         <string>ID</string>
        </property>
       </column>
       <column>
        <property name="text">
         <string>Type</string>
        </property>
       </column>
       <column>
        <property name="text">
         <string>Quantité</string>
        </property>
       </column>
       <column>
        <property name="text">
         <string>Seuil Alerte</string>
        </property>
       </column>
      </widget>
     </item>
     <item>
      <widget class="QFrame" name="formPanel">
       <property name="minimumSize">
        <size>
         <width>350</width>
         <height>0</height>
        </size>
       </property>
       <layout class="QVBoxLayout" name="formLayout">
        <property name="spacing">
         <number>10</number>
        </property>
        <item>
         <widget class="QLabel" name="labelFormTitle">
          <property name="text">
           <string>Informations du Stock</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelId">
          <property name="text">
           <string>Id Stock</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="inputId"/>
        </item>
        <item>
         <widget class="QLabel" name="labelType">
          <property name="text">
           <string>Type Stock</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="inputType"/>
        </item>
        <item>
         <widget class="QLabel" name="labelQuantite">
          <property name="text">
           <string>Quantité</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="inputQuantite"/>
        </item>
        <item>
         <widget class="QLabel" name="labelSeuil">
          <property name="text">
           <string>Seuil Alerte</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="inputSeuil"/>
        </item>
        <item>
         <layout class="QHBoxLayout" name="formButtons">
          <item>
           <widget class="QPushButton" name="btnAdd">
            <property name="text">
             <string>Ajouter Stock</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnUpdate">
            <property name="text">
             <string>Modifier Stock</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnDeleteForm">
            <property name="text">
             <string>Supprimer</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
