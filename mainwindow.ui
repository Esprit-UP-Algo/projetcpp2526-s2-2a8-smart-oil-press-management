           </attribute>
           <layout class="QVBoxLayout">
            <property name="spacing">
             <number>15</number>
            </property>
            <property name="margin" stdset="0">
             <number>20</number>
            </property>
            <item>
             <widget class="QLabel" name="mailingHeaderLabel">
              <property name="styleSheet">
               <string>font-size: 20px; color: #2d4a1f; font-weight: bold;</string>
              </property>
              <property name="text">
               <string>📧 Envoyer un Email aux Partenaires</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignCenter</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QFrame" name="mailingFrame">
              <property name="styleSheet">
               <string>background: white; border: 2px solid #5d732c; border-radius: 8px;</string>
              </property>
              <layout class="QVBoxLayout">
               <property name="spacing">
                <number>15</number>
               </property>
               <property name="margin" stdset="0">
                <number>20</number>
               </property>
               <item>
                <widget class="QLabel" name="subjectLabel">
                 <property name="styleSheet">
                  <string>color: #2d4a1f; font-weight: bold;</string>
                 </property>
                 <property name="text">
                  <string>Sujet</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLineEdit" name="subjectLineEdit">
                 <property name="styleSheet">
                  <string>padding: 8px; border: 2px solid #5d732c; border-radius: 6px;</string>
                 </property>
                 <property name="placeholderText">
                  <string>Entrez le sujet du message...</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="messageLabel">
                 <property name="styleSheet">
                  <string>color: #2d4a1f; font-weight: bold;</string>
                 </property>
                 <property name="text">
                  <string>Message</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QTextEdit" name="messageTextEdit">
                 <property name="styleSheet">
                  <string>padding: 8px; border: 2px solid #5d732c; border-radius: 6px;</string>
                 </property>
                 <property name="placeholderText">
                  <string>Rédigez votre message ici...</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="sendMailButton">
                 <property name="styleSheet">
                  <string>background: #ffd700; color: #2d4a1f; border: none; padding: 12px 30px; border-radius: 8px; font-weight: bold;</string>
                 </property>
                 <property name="text">
                  <string>📤 Envoyer aux Partenaires</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <spacer>
              <property name="orientation">
               <enum>Qt::Orientation::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
