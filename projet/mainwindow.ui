  <property name="styleSheet">
   <string>
/* GLOBAL */
QMainWindow {
    background-color: #f5f5f5;
    font-family: Segoe UI;
    font-size: 13px;
}

/* SIDEBAR */
#sidebar {
    background-color: #2d4a1f;
}

#sidebar QPushButton {
    background-color: #ffd700;
    color: #2d4a1f;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    text-align: left;
}

#sidebar QPushButton:hover {
    background-color: #ffed4e;
}

/* HEADER */
#headerLabel {
    font-size: 26px;
    font-weight: bold;
    color: #2d4a1f;
    padding: 20px;
}

/* TAB WIDGET */
QTabWidget::pane {
    border: 2px solid #5d732c;
    border-radius: 8px;
    background: white;
}

QTabBar::tab {
    background: #eaeaea;
    padding: 10px 25px;
    margin-right: 5px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #2d4a1f;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #ffd700;
}

/* INPUTS */
QLineEdit, QComboBox, QTextEdit {
    border: 2px solid #5d732c;
    border-radius: 6px;
    padding: 6px;
    background: white;
    color: #2d4a1f;
}

/* SEARCH BAR */
#searchLineEdit {
    border: 2px solid #5d732c;
    border-radius: 6px;
    padding: 10px;
    background: white;
    color: #2d4a1f;
    font-size: 14px;
}

/* TABLE */
QTableWidget {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #5d732c;
    color: white;
    padding: 8px;
    font-weight: bold;
}

/* ACTION BUTTONS */
QPushButton {
    background-color: #ffd700;
    color: #2d4a1f;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ffed4e;
}

/* SEARCH BUTTONS - JAUNE */
#searchButton, #filterButton, #refreshButton, #exportButton {
    background-color: #ffd700;
    color: #2d4a1f;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: bold;
    min-width: 100px;
}

#searchButton:hover, #filterButton:hover, #refreshButton:hover, #exportButton:hover {
    background-color: #ffed4e;
}

#clearButton {
    background-color: #dc3545;
    color: white;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: bold;
}

#clearButton:hover {
    background-color: #c82333;
}
   </string>
