  <property name="styleSheet">
   <string notr="true">
/* Main Widget */
QMainWindow#MainWindow {
    background: #f5f5f5;
}

/* LEFT SIDEBAR */
QFrame#sidebar {
    background-color: #2d4a1f;
    border: none;
}

QLabel#userName {
    color: white;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#userRole {
    color: #c9c9c9;
    font-size: 12px;
    background: transparent;
}

QLabel#userIcon {
    font-size: 32px;
    background: transparent;
    color: #ffd700;
}

/* Navigation Buttons */
QPushButton.navButton {
    background: #ffd700;
    color: #2d4a1f;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
}

QPushButton.navButton:hover {
    background: #ffed4e;
}

QPushButton.settingsButton {
    background: transparent;
    color: #ffd700;
    border: none;
    padding: 8px;
    font-size: 12px;
    text-align: left;
}

QPushButton.settingsButton:hover {
    color: #ffed4e;
}

/* RIGHT PANEL */
QFrame#contentArea {
    background-color: #ffffff;
    border-left: 3px solid #5d732c;
}

/* Header */
QFrame#headerFrame {
    background: #ffffff;
    border: none;
    border-bottom: 3px solid #5d732c;
}

QLabel#headerTitle {
    color: #2d4a1f;
    font-size: 28px;
    font-weight: bold;
}

QLabel#headerIcon {
    color: #5d732c;
    font-size: 32px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 2px solid #5d732c;
    border-radius: 8px;
    background: white;
    top: -2px;
}

QTabBar::tab {
    background: #f0f0f0;
    color: #2d4a1f;
    padding: 12px 30px;
    margin-right: 5px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 13px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #ffd700;
    color: #2d4a1f;
}

QTabBar::tab:hover {
    background: #ffed4e;
}

/* Search Box */
QLineEdit#searchBox {
    padding: 10px 15px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    font-size: 13px;
    color: #2d4a1f;
}

/* Action Buttons */
QPushButton.actionButton {
    background: #ffd700;
    color: #2d4a1f;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton.actionButton:hover {
    background: #ffed4e;
}

QPushButton#btnDelete {
    background: #dc3545;
    color: white;
}

QPushButton#btnDelete:hover {
    background: #c82333;
}

/* Table */
QTableWidget {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
    gridline-color: #e0e0e0;
    font-size: 13px;
    color: #2d4a1f;
}

QTableWidget::item:selected {
    background: #ffd700;
    color: #2d4a1f;
}

QHeaderView::section {
    background: #5d732c;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
    font-size: 13px;
}

/* Form Panel */
QFrame#formPanel {
    background: white;
    border: 2px solid #5d732c;
    border-radius: 8px;
}

QLabel.formLabel {
    color: #2d4a1f;
    font-size: 13px;
    font-weight: bold;
}

QLineEdit.formInput,
QComboBox.formInput,
QSpinBox.formInput,
QDoubleSpinBox.formInput,
QDateEdit.formInput {
    padding: 8px 12px;
    border: 2px solid #5d732c;
    border-radius: 6px;
    background: white;
    font-size: 13px;
    color: #2d4a1f;
}

/* Form Buttons */
QPushButton.formButton {
    background: #ffd700;
    color: #2d4a1f;
    border: none;
    padding: 12px 30px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton.formButton:hover {
    background: #ffed4e;
}
